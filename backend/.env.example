# Server Configuration
PORT=5000

# MongoDB Database Connection String
# Example local MongoDB: mongodb://127.0.0.1:27017/healthytrack
# Example Atlas MongoDB: mongodb+srv://<username>:<password>@cluster.mongodb.net/healthytrack
DATABASE=mongodb://127.0.0.1:27017/healthytrack

# JWT Secret Key for token signing and authentication
TOKEN_SECRET=your_jwt_secret_key_here

